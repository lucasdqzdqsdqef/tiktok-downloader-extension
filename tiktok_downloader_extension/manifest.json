{
  "manifest_version": 3,
  "name": "TikTok Downloader",
  "version": "1.2",
  "description": "Download TikTok videos without watermarks at maximum quality.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.tikwm.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "ext_logo_sq.png"
  },
  "icons": {
    "16": "ext_logo_sq.png",
    "32": "ext_logo_sq.png",
    "48": "ext_logo_sq.png",
    "128": "ext_logo_sq.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["ext_logo_sq.png"],
      "matches": ["*://*.tiktok.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
